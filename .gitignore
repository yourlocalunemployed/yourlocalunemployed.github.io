
# Hugo build output — Cloudflare Pages rebuilds this from source on every push,
# so committing it is redundant (and makes noisy diffs / risks a stale copy).
public/
.hugo_build.lock

# local backup archives (stored off-repo, never commit)
blog-backups/
*.tar.gz

# Hugo image-processing cache (regenerated at build)
resources/

# Raw source notes — unredacted originals (real credentials, full addressing)
# that the published posts redact. This repo is public: never commit or -f add.
# They still go off-VM in the backup-blog.sh tarballs, which include untracked files.
notes/

# Claude Code: local machine-specific settings + write temp files stay local;
# the shared project config (.claude/settings.json) and hooks ARE committed.
.claude/settings.local.json
.claude/*.tmp.*

# site-specific leak patterns for the TALEB ILM exporter (never commit)
scripts/leak-patterns.local
__pycache__/
